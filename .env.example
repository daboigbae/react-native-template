# All env vars are read via lib/constants/env.ts — never via process.env directly.
# Anything client-side must be prefixed with EXPO_PUBLIC_.

EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_ENV=development

# Observability (Context A only — strip on Context B/C client projects unless approved)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# EAS / build secrets (NOT prefixed — server-side only)
SENTRY_AUTH_TOKEN=
